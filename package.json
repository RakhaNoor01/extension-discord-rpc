{
  "name": "extension-rpc",
  "displayName": "Dly's Extension RPC",
  "icon": "images/icon.png",
  "description": "Custom Personal Discord Rich Presence for Visual Studio Code",
  "version": "0.2.0",
  "engines": {
    "vscode": "^1.134.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "extensionRpc.openControlMenu",
        "title": "Open Control Menu",
        "category": "Extension RPC"
      },
      {
        "command": "extensionRpc.toggle",
        "title": "Toggle Rich Presence",
        "category": "Extension RPC"
      },
      {
        "command": "extensionRpc.selectIcon",
        "title": "Select Project Icon",
        "category": "Extension RPC"
      },
      {
        "command": "extensionRpc.reconnect",
        "title": "Reconnect to Discord",
        "category": "Extension RPC"
      },
      {
        "command": "extensionRpc.openSettings",
        "title": "Open Settings",
        "category": "Extension RPC"
      }
    ],
    "configuration": {
      "title": "Extension RPC",
      "properties": {
        "extensionRpc.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable or disable Discord Rich Presence."
        },
        "extensionRpc.detailsFormat": {
          "type": "string",
          "default": "Working on {project}",
          "description": "Primary Rich Presence text. Variables: {project}, {file}, {language}, and {icon}."
        },
        "extensionRpc.stateFormat": {
          "type": "string",
          "default": "Editing {file}",
          "description": "Secondary Rich Presence text. Variables: {project}, {file}, {language}, and {icon}."
        },
        "extensionRpc.largeImageTextFormat": {
          "type": "string",
          "default": "{project} • {language}",
          "description": "Text displayed when hovering over the large image."
        },
        "extensionRpc.showElapsedTime": {
          "type": "boolean",
          "default": true,
          "description": "Show how long the current VS Code session has been running."
        },
        "extensionRpc.iconOverride": {
          "type": "integer",
          "default": 0,
          "minimum": 0,
          "maximum": 23,
          "description": "Force an icon from 1 to 23. Use 0 for automatic project-based selection."
        },
        "extensionRpc.activityType": {
          "type": "string",
          "default": "playing",
          "enum": [
            "playing",
            "listening",
            "watching",
            "competing"
          ],
          "enumDescriptions": [
            "Display Playing on Discord.",
            "Display Listening on Discord.",
            "Display Watching on Discord.",
            "Display Competing on Discord."
          ],
          "description": "Select the activity type displayed on Discord."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.134.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.9.2",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "dependencies": {
    "@xhayper/discord-rpc": "^1.3.4"
  }
}